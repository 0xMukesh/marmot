|00 @System &vector $2 &pad $6 &r $2 &g $2 &b $2
|10 @Console/vector $2 &read $5 &type $1 &write $1 &error $1

%EMIT { .Console/write DEO } ( character -- )
%NL { #0a .Console/write DEO } ( -- )

|0100
    #2ce9 .System/r DEO2
    #01c0 .System/g DEO2
    #2ce5 .System/b DEO2

    LIT "h EMIT
    LIT "e EMIT
    LIT "l EMIT
    LIT "l EMIT
    LIT "o EMIT
    NL ( newline )
